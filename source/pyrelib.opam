opam-version: "1.2"
version: "0.1"
maintainer: "pysa@meta.com"
authors: ["Pysa team"]
homepage: "https://github.com/facebook/Pysa"
bug-reports: "https://github.com/facebook/Pysa/issues"
dev-repo: "https://github.com/facebook/Pysa.git"
license: "MIT"
build: [["jbuilder" "build" "-p" name "-j" jobs "@install"]]
build-test: [["jbuilder" "runtest" "-p" name "-j" jobs]]
depends: [
  "core"
  "yojson"
  "ppxlib"
  "ppx_deriving"
  "ppx_deriving_yojson"
  "menhir"
  "ounit" {test}
]
